        // --- Email Submission Function ---

        function sendEmailSummary(event) {
            event.preventDefault(); // Stop default form submission/page reload
            
            // Basic form validation for required fields before email generation
            if (!document.getElementById('coCreationForm').checkValidity()) {
                alert("Please fill out all required fields in Section 1 and Section 4 (if enabled) before sending.");
                return;
            }

            // 1. Collect Core Data
            const title = document.getElementById('title').value || 'N/A';
            const reporter = document.getElementById('reporter').value || 'N/A';
            const totalScore = document.getElementById('total-score').textContent;
            const statusInput = document.querySelector('input[name="storyStatus"]:checked');
            const status = statusInput ? statusInput.value.toUpperCase() : 'N/A';
            const decisionTitle = document.getElementById('protocol-action-title').textContent;
            
            // 2. Collect T-CC Plan Details (only if high priority)
            let tccDetails = "";
            if (parseInt(totalScore) >= 4) {
                tccDetails = `
--- SECTION 4: T-CC PLAN (MANDATORY) ---
1. Contextual Bridging: ${document.getElementById('tcc-context-bridging').value || 'N/A'}
2. Source Quote Check (in Spanish?): ${document.getElementById('source-in-spanish').checked ? 'YES' : 'NO'}
3. Original Spanish Quote: ${document.getElementById('tcc-original-quote').value || 'N/A'}
4. Call to Action/Resources: ${document.getElementById('tcc-call-to-action').value || 'N/A'}
5. LDS Terms Check: ${document.getElementById('lds-terms-check').checked ? 'YES' : 'NO'}
6. LDS Terms to Verify: ${document.getElementById('tcc-lds-terms').value || 'N/A'}
---
`;
            }

            // 3. Assemble the Email Body
            const emailBody = `
=== Translation Co-creation Assessment Summary ===

STORY TITLE: ${title}
REPORTER: ${reporter}
ASSIGNED DATE: ${document.getElementById('date').value || 'N/A'}

CURRENT STATUS: ${status}
TOTAL RELEVANCE SCORE: ${totalScore}

--- SECTION 3: DECISION & ACTION ---
PROTOCOL: ${decisionTitle}

GUIDANCE:
${document.getElementById('protocol-action-text').textContent}

${tccDetails}

--- END OF ASSESSMENT ---
`;
            
            // 4. Create mailto Link
            const subject = `[T-CC Priority ${totalScore}] ${title} - ${status}`;
            const mailtoLink = `mailto:${CONTENT_LEAD_EMAIL}?cc=${EDITORIAL_INBOX_EMAIL}&subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(emailBody)}`;
            
            // Open the email client
            window.open(mailtoLink);
        }

        // --- Event Listeners and Initial Load ---

        document.addEventListener('DOMContentLoaded', () => {
            // Event listeners to trigger scoring and decision update
            scoreInputs.forEach(input => {
                input.addEventListener('change', calculateScore);
            });
            
            // Add listener for story status changes
            statusInputs.forEach(input => {
                input.addEventListener('change', calculateScore);
            });
            
            // Add listener for content changes (to enable Gemini button)
            storyContentInput.addEventListener('input', calculateScore);


            // Re-calculate the score and update the decision on load
            calculateScore();
        });
    </script>
